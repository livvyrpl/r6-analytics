diff --git a/dissect/operator_roles.go b/dissect/operator_roles.go
index ce9ea22..dbbf238 100644
--- a/dissect/operator_roles.go
+++ b/dissect/operator_roles.go
@@ -81,6 +81,7 @@ var _operatorRoles = map[Operator]TeamRole{
 	92270644293:  Defense,
 	92270644319:  Defense,
 	92270644345:  Attack,
+	456757346397: Defense, // Noor
 }
 
 func (i Operator) Role() TeamRole {
@@ -89,3 +90,15 @@ func (i Operator) Role() TeamRole {
 	}
 	panic(fmt.Sprintf("role unknown for operator ID %d", i))
 }
+
+// KnownRole is like Role but reports false instead of panicking when the
+// operator id is not in the table (a game build newer than this parser).
+func (i Operator) KnownRole() (TeamRole, bool) {
+	r, ok := _operatorRoles[i]
+	return r, ok
+}
+
+func isDefenseOp(o Operator) bool {
+	r, ok := o.KnownRole()
+	return ok && r == Defense
+}
